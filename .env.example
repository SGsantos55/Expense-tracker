# Copy to .env and fill in real values. Do NOT commit .env.
ADMIN_EMAIL=admin@example.com

# PostgreSQL connection (psycopg 3). Local dev uses the Unix socket with
# peer auth; override host/port/user/password for hosted databases.
DATABASE_URL=postgresql:///spendly

# Google OAuth
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Email delivery (verification & password-reset emails)
#
# Preferred: Resend HTTP API. Works on hosts that block SMTP ports
# (e.g. Render's free tier). When RESEND_API_KEY is set it takes
# precedence over the SMTP settings below.
RESEND_API_KEY=
# MAIL_FROM must be a verified Resend sender/domain.
# "onboarding@resend.dev" works for quick testing.
MAIL_FROM=Spendly <onboarding@resend.dev>

# SMTP fallback (used only when RESEND_API_KEY is empty).
# NOTE: Render free-tier services cannot use outbound SMTP (ports 25/465/587).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
