# Copy to .env and fill in real values. Do NOT commit .env.
ADMIN_EMAIL=admin@example.com

# PostgreSQL connection (psycopg 3). Local dev uses the Unix socket with
# peer auth; override host/port/user/password for hosted databases.
DATABASE_URL=postgresql:///spendly

# AI financial insights (Groq). Phase 1 uses deterministic analytics only;
# the Groq client is wired up in a later phase.
AI_ENABLED=false
GROQ_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_SUMMARY_PROMPT_VERSION=summary-v1
AI_CHAT_PROMPT_VERSION=chat-v1
AI_SUMMARY_LIMIT_PER_HOUR=5
AI_CHAT_LIMIT_PER_MINUTE=10
AI_CHAT_LIMIT_PER_DAY=200
AI_MAX_PERIOD_DAYS=366
BUDGET_WARNING_THRESHOLD=90

# Google OAuth
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Email delivery (verification & password-reset emails)
#
# Preferred: Resend HTTP API. Works on hosts that block SMTP ports
# (e.g. Render's free tier). When RESEND_API_KEY is set it takes
# precedence over the SMTP settings below.
RESEND_API_KEY=
# MAIL_FROM must be a verified Resend sender/domain.
# "onboarding@resend.dev" works for quick testing.
MAIL_FROM=Expense Tracker <onboarding@resend.dev>

# SMTP fallback (used only when RESEND_API_KEY is empty).
# NOTE: Render free-tier services cannot use outbound SMTP (ports 25/465/587).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
