# Copy to .env and fill in real values. Do NOT commit .env.
ADMIN_EMAIL=admin@example.com

# Google OAuth
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# SMTP (authentication emails: verification & password reset)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
